{
  "name": "catprice",
  "version": "1.3.10",
  "description": "Windows desktop app for catalyst cost estimation and source-linked benchmark workflows",
  "main": "electron/main.js",
  "author": "hyunjin.kang",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyunjin-kor/CatPrice.git"
  },
  "bugs": {
    "url": "https://github.com/hyunjin-kor/CatPrice/issues"
  },
  "homepage": "https://github.com/hyunjin-kor/CatPrice#readme",
  "//port": "8765 must match BACKEND_PORT in electron/main.js (single source of truth)",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run electron:wait\"",
    "dev:backend": "uvicorn backend.main:app --host 127.0.0.1 --port 8765 --reload",
    "dev:frontend": "cross-env VITE_BACKEND_PORT=8765 cd frontend && npm run dev",
    "electron:wait": "wait-on http://127.0.0.1:8765/api/health http://localhost:5173 && npm run electron:dev",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "desktop:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop_catprice_processes.ps1 -Quiet",
    "smoke:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke_test_desktop.ps1",
    "build": "npm run build:frontend && npm run build:backend-sidecar && npm run electron:build",
    "build:frontend": "cd frontend && npm run build",
    "build:backend-sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_backend_bundle.ps1",
    "electron:build": "npm run desktop:stop && electron-builder build --win",
    "pack": "npm run build:frontend && npm run build:backend-sidecar && npm run desktop:stop && electron-builder --dir",
    "pack:smoke": "npm run pack && npm run smoke:desktop"
  },
  "build": {
    "appId": "com.catprice.app",
    "productName": "CatPrice",
    "copyright": "Copyright 2026 hyunjin.kang",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/backend-sidecar/CatPriceBackend",
        "to": "backend-sidecar"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/public/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CatPrice"
    }
  },
  "dependencies": {
    "electron-log": "^5.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.0"
  }
}
