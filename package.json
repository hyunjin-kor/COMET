{
  "name": "catprice",
  "version": "1.0.0",
  "description": "Real-time metal price based catalyst manufacturing cost estimator",
  "main": "electron/main.js",
  "author": "CatPrice Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run electron:wait\"",
    "dev:backend": "uvicorn backend.main:app --host 127.0.0.1 --port 8765 --reload",
    "dev:frontend": "cross-env VITE_BACKEND_PORT=8765 cd frontend && npm run dev",
    "electron:wait": "wait-on http://127.0.0.1:8765/api/health http://localhost:5173 && npm run electron:dev",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "build": "npm run build:frontend && npm run electron:build",
    "build:frontend": "cd frontend && npm run build",
    "electron:build": "electron-builder build --win",
    "electron:build:all": "electron-builder build -mwl",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.catprice.app",
    "productName": "CatPrice",
    "copyright": "Copyright © 2024 CatPrice Contributors",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!tests/**",
          "!*.pyc"
        ]
      },
      {
        "from": "backend/data",
        "to": "backend/data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CatPrice"
    },
    "mac": {
      "target": "dmg",
      "icon": "frontend/public/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "frontend/public/icon.png",
      "category": "Science"
    }
  },
  "dependencies": {
    "electron-log": "^5.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "wait-on": "^8.0.0"
  }
}
