# COMET Environment Configuration
# Copy this file to .env and fill in your API keys

# Metal Price APIs (optional - falls back to reference prices)
METALS_DEV_API_KEY=
METALPRICE_API_KEY=

# BLS API (optional - for automatic ChemPPI updates)
BLS_API_KEY=

# UN Comtrade Plus (optional - monthly import unit values for supports on the academic basis)
COMTRADE_API_KEY=

# Database (default: SQLite)
DATABASE_URL=sqlite:///./comet.db

# Debug mode
DEBUG=false

# Daily price update hour (UTC)
PRICE_UPDATE_HOUR=6

# Optional override for loopback desktop development origins
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional hosted service; defaults off. Read docs/commercial/hosted-operations.ko.md.
# A valid commercial data-rights review is required; no approval bypass exists.
HOSTED_MODE=false
# HOSTED_ORIGIN=https://YOUR_SERVICE_HOST
# ALLOWED_HOSTS=YOUR_SERVICE_HOST
# HOSTED_STORAGE_DIR=ABSOLUTE_PRIVATE_DIRECTORY_OUTSIDE_SOURCE
# HOSTED_RIGHTS_MANIFEST=docs/commercial/data-rights-2026-09-07.json
