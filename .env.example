# CatPrice Environment Configuration
# Copy this file to .env and fill in your API keys

# Metal Price APIs (optional - falls back to reference prices)
METALS_DEV_API_KEY=
METALPRICE_API_KEY=

# BLS API (optional - for automatic ChemPPI updates)
BLS_API_KEY=

# Database (default: SQLite)
DATABASE_URL=sqlite:///./catprice.db

# Debug mode
DEBUG=false

# Daily price update hour (UTC)
PRICE_UPDATE_HOUR=6

# CORS allowed origins (comma-separated, for production deployment)
# Default covers local dev. Set this to your production domain.
# CORS_ORIGINS=https://catprice.example.com
